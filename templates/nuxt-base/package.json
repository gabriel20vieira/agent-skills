{
    "name": "nuxt-base",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node --env-file-if-exists=.env node_modules/nuxt/bin/nuxt.mjs dev",
        "build": "nuxt build",
        "start": "node --env-file-if-exists=.env .output/server/index.mjs",
        "postinstall": "nuxt prepare",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "nuxt typecheck",
        "test": "vitest run",
        "test:watch": "vitest",
        "check": "npm run lint && npm run typecheck && npm run test",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "node --env-file-if-exists=.env scripts/baseline-migrations.mjs && drizzle-kit migrate"
    },
    "dependencies": {
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/geist-mono": "^5.2.0",
        "@lucide/vue": "^1.47.0",
        "@nuxtjs/color-mode": "^4.0.1",
        "@nuxtjs/i18n": "^10.6.0",
        "@vueuse/core": "^14.4.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "drizzle-orm": "^0.45.2",
        "h3": "^1.15.11",
        "mysql2": "^3.24.4",
        "nuxt": "^4.5.2",
        "reka-ui": "^2.10.4",
        "tailwind-merge": "^3.7.0",
        "vue": "^3.5.28",
        "vue-router": "^5.3.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@nuxt/eslint": "^1.17.0",
        "@tailwindcss/vite": "^4.3.3",
        "drizzle-kit": "^0.31.10",
        "eslint": "^9.39.0",
        "shadcn-nuxt": "^2.8.2",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3",
        "vitest": "^5.0.1",
        "vue-tsc": "^3.3.11"
    },
    "allowScripts": {
        "esbuild@0.28.2": true,
        "esbuild@0.25.12": true,
        "esbuild@0.18.20": true,
        "unrs-resolver@1.12.2": true,
        "vue-demi@0.14.10": true
    }
}
